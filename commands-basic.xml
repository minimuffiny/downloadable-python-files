<!-- a basic structure -->
<commands xmlns="https://commands.com/">
  <command name="prank" logic="echo hahaha"/>
  <command name="gong" logic="echo bell; mkdir bell"/>
  <command name="hello" logic="echo Hello, world!"/>
  <command name="goodbye" logic="echo See you later!"/>
  <command name="status" logic="echo Ready for commands!"/>
  <command name="joke" logic="echo Why did the programmer quit? Too many bugs!"/>
  <command name="python-version" logic="python --version"/>
  <command name="make-notes" logic="mkdir notes"/>
  <command name="make-projects" logic="mkdir projects"/>
</commands>
